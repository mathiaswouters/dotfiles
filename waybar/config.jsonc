// Waybar. Labels use plain Unicode rather than Nerd Font private-use glyphs,
// so the bar stays readable on a machine where no patched font is installed.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 2,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 60,
    "rewrite": {
      "(.*) — Mozilla Firefox": "firefox · $1",
      "(.*) - Ghostty": "$1"
    }
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "idle"
    },
    "tooltip-format-activated": "Idle inhibited — screen will not lock",
    "tooltip-format-deactivated": "Idle timeout active"
  },

  "cpu": {
    "format": "cpu {usage}%",
    "interval": 5,
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "format": "mem {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB of {total:0.1f} GiB",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },

  // No thermal zone exists in most VMs, so the module hides itself there.
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "interval": 10
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "muted",
    "format-bluetooth": "bt {volume}%",
    "format-source": "mic {volume}%",
    "format-source-muted": "mic off",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-linked": "no ip",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} · {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} · {ipaddr} · {signalStrength}%",
    "interval": 10
  },

  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "bat {capacity}%",
    "format-charging": "chg {capacity}%",
    "format-plugged": "ac {capacity}%",
    "tooltip-format": "{timeTo} ({power:0.1f} W)"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
