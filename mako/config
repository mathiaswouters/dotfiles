# Mako notification daemon. Catppuccin Mocha, JetBrains Mono.

font=JetBrains Mono 10
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #313244

width=380
height=140
margin=10
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right

# Waybar sits at the top with a 2px margin and 30px height; offset past it so
# notifications do not overlap the bar.
outer-margin=40,10,0,0

[urgency=low]
border-color=#6c7086
text-color=#a6adc8
default-timeout=4000

[urgency=normal]
border-color=#b4befe

# Critical notifications must be dismissed deliberately.
[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[category=volume]
default-timeout=1500
history=0
